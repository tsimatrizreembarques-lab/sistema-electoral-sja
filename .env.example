# Puerto local (Cloud Run lo sobreescribe automaticamente con PORT=8080)
PORT=3000

# Secreto para firmar los tokens de sesion (login por puesto). Cambiar por uno propio.
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# JSON COMPLETO de la cuenta de servicio de Google Cloud (con permisos de
# Firestore y de Google Sheets), en una sola linea. Mismo mecanismo que
# GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT en sistema-turnos-pro.
GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT={"type":"service_account","project_id":"..."}

# ID de la Google Sheet donde se guarda el respaldo (no es la base principal).
GOOGLE_SHEET_ID_BACKUP=
